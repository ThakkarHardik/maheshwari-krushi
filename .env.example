# PostgreSQL connection string (local Postgres, Neon or Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maheshwari_krishi?schema=public"
# Neon / Supabase: DATABASE_URL = the POOLED connection string (used by the website),
# DIRECT_DATABASE_URL = the DIRECT connection string (used only for migrations).
# DIRECT_DATABASE_URL=""

# Only for the local `npx prisma dev` database, which supports one connection at a time.
# Leave unset for real PostgreSQL (Neon, Supabase, your own server).
# DATABASE_POOL_MAX=1

# Public address of the website (used for links, sitemap and social previews)
NEXT_PUBLIC_SITE_URL="https://www.example.in"

# Secret for signing admin session cookies — at least 32 random characters.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=""

# Owner admin account created by `npm run db:seed`
SEED_OWNER_EMAIL="maheshwariksksailana@gmail.com"
SEED_OWNER_PASSWORD=""
# Set to "false" in production to skip the 4 sample products and their dummy opening stock
SEED_SAMPLE_PRODUCTS="true"

# Product image storage: "local" (default, development only — saves to ./uploads)
# or "cloudinary" (production; Vercel has no persistent disk)
STORAGE_DRIVER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
