// Maheshwari Krishi Sewa Kendra — database schema.
// Money is always Decimal (never Float). Selling prices include GST.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum AdminRole {
  OWNER
  MANAGER
  PACKER
}

enum Season {
  KHARIF
  RABI
  ZAID
}

enum Unit {
  GM
  KG
  ML
  LTR
  PIECE
  PACKET
}

enum StockMovementType {
  PURCHASE
  SALE
  RESERVE
  RELEASE
  RETURN
  DAMAGE
  ADJUSTMENT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  UPI
  CARD
  COD
}

enum OrderPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  COD_PENDING
  COD_COLLECTED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

enum EnquirySource {
  FORM
  WHATSAPP
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum NotificationChannel {
  SMS
  WHATSAPP
}

enum NotificationStatus {
  /// Waiting to be sent by hand (no automatic provider configured)
  QUEUED
  SENT
  FAILED
  /// Sent by staff via WhatsApp from the admin panel
  MANUAL_SENT
}

enum CouponType {
  PERCENT
  FLAT
}

// ───────────────────────────── People ─────────────────────────────

model AdminUser {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                AdminRole
  isActive            Boolean   @default(true)
  /// Bumped on password change / deactivation to invalidate existing sessions.
  sessionVersion      Int       @default(1)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  /// Optional TOTP (2FA) secret — not used yet.
  totpSecret          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  auditLogs      AuditLog[]
  stockMovements StockMovement[]
  statusChanges  OrderStatusHistory[]
  refunds        Refund[]
}

model Customer {
  id               String   @id @default(cuid())
  name             String
  /// 10-digit Indian mobile number, without +91.
  mobile           String   @unique
  isMobileVerified Boolean  @default(false)
  isBlocked        Boolean  @default(false)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  addresses Address[]
  orders    Order[]
  carts     Cart[]
  reviews   Review[]
  enquiries Enquiry[]
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  fullName   String
  mobile     String
  line1      String
  city       String
  district   String?
  state      String   @default("Madhya Pradesh")
  pincode    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model OtpCode {
  id        String    @id @default(cuid())
  mobile    String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([mobile, createdAt])
}

// ───────────────────────────── Catalogue ─────────────────────────────

model Category {
  id            String   @id @default(cuid())
  slug          String   @unique
  nameHi        String
  nameEn        String
  descriptionHi String?
  imageUrl      String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products Product[]
}

model Crop {
  id      String   @id @default(cuid())
  slug    String   @unique
  nameHi  String
  nameEn  String
  seasons Season[]

  products ProductCrop[]
}

model Product {
  id             String    @id @default(cuid())
  slug           String    @unique
  nameHi         String
  nameEn         String?
  /// Short label shown under the name, e.g. "(प्लांट टॉनिक)".
  subLabelHi     String?
  subLabelEn     String?
  descriptionHi  String?
  descriptionEn  String?
  benefitsHi     String[]
  benefitsEn     String[]
  usageHi        String?
  usageEn        String?
  safetyHi       String?
  manufacturer   String?
  licenceNo      String?
  hsnCode        String
  gstRate        Decimal   @db.Decimal(5, 2)
  categoryId     String
  isFeatured     Boolean   @default(false)
  isActive       Boolean   @default(true)
  ratingAvg      Decimal   @default(0) @db.Decimal(3, 2)
  ratingCount    Int       @default(0)
  /// Lowest active variant price — kept in sync by lib/catalog/variants.ts for sorting and listing.
  minPrice       Decimal?  @db.Decimal(10, 2)
  seoTitle       String?
  seoDescription String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  category  Category         @relation(fields: [categoryId], references: [id])
  images    ProductImage[]
  variants  ProductVariant[]
  crops     ProductCrop[]
  reviews   Review[]
  enquiries Enquiry[]

  @@index([categoryId, isActive])
  @@index([isFeatured])
  @@index([minPrice])
}

model ProductImage {
  id         String  @id @default(cuid())
  productId  String
  url        String
  /// Provider-prefixed key used to delete the file, e.g. "local:products/abc.jpg".
  storageKey String?
  alt        String?
  sortOrder  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductCrop {
  productId String
  cropId    String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  crop    Crop    @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@id([productId, cropId])
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  sku               String   @unique
  packSize          Decimal  @db.Decimal(10, 3)
  unit              Unit
  /// Display label, e.g. "1 लीटर" or "450 ग्राम".
  label             String
  mrp               Decimal  @db.Decimal(10, 2)
  /// Selling price, inclusive of GST.
  price             Decimal  @db.Decimal(10, 2)
  lowStockThreshold Int      @default(5)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  batches        InventoryBatch[]
  stockMovements StockMovement[]
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([productId])
}

model Review {
  id         String       @id @default(cuid())
  productId  String
  customerId String?
  name       String
  rating     Int
  comment    String?
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([productId, status])
}

// ───────────────────────────── Inventory ─────────────────────────────

model InventoryBatch {
  id           String    @id @default(cuid())
  variantId    String
  batchNo      String
  mfgDate      DateTime?
  expiryDate   DateTime?
  qtyReceived  Int
  qtyAvailable Int
  costPrice    Decimal?  @db.Decimal(10, 2)
  supplier     String?
  receivedAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  variant        ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  stockMovements StockMovement[]
  allocations    OrderItemBatch[]

  @@unique([variantId, batchNo])
  @@index([variantId, expiryDate])
}

model StockMovement {
  id          String            @id @default(cuid())
  variantId   String
  batchId     String?
  type        StockMovementType
  /// Signed quantity: positive adds stock, negative removes it.
  quantity    Int
  reason      String?
  orderId     String?
  adminUserId String?
  createdAt   DateTime          @default(now())

  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  batch     InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  order     Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  adminUser AdminUser?      @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([orderId])
}

// ───────────────────────────── Cart & Orders ─────────────────────────────

model Cart {
  id         String   @id @default(cuid())
  customerId String?
  /// Random token stored in a cookie for guest carts.
  guestToken String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@index([customerId])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

/// Atomic counters, e.g. key "order" → next MKSC order number.
model Counter {
  key   String @id
  value Int    @default(0)
}

model Order {
  id            String             @id @default(cuid())
  /// e.g. "MKSC12345"
  orderNumber   String             @unique
  customerId    String
  status        OrderStatus        @default(PENDING)
  paymentMethod PaymentMethod
  paymentStatus OrderPaymentStatus @default(PENDING)

  // Delivery address snapshot
  shipName     String
  shipMobile   String
  shipLine1    String
  shipCity     String
  shipDistrict String?
  shipState    String
  shipPincode  String

  subtotal       Decimal @db.Decimal(12, 2)
  discountTotal  Decimal @default(0) @db.Decimal(12, 2)
  shippingCharge Decimal @default(0) @db.Decimal(12, 2)
  taxableTotal   Decimal @db.Decimal(12, 2)
  cgstTotal      Decimal @default(0) @db.Decimal(12, 2)
  sgstTotal      Decimal @default(0) @db.Decimal(12, 2)
  igstTotal      Decimal @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal @db.Decimal(12, 2)

  couponId       String?
  couponCode     String?
  customerNote   String?
  adminNote      String?
  courierName    String?
  trackingNumber String?
  codCollectedAt DateTime?
  /// GST invoice number, e.g. "MKSC/2026-27/0001" — assigned when the order is packed.
  invoiceNumber  String?   @unique
  invoiceDate    DateTime?
  /// Unpaid online orders expire at this time and release reserved stock.
  expiresAt      DateTime?
  placedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  coupon         Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  payments       Payment[]
  refunds        Refund[]
  statusHistory  OrderStatusHistory[]
  stockMovements StockMovement[]
  notifications  Notification[]

  @@index([customerId])
  @@index([status, placedAt])
  @@index([paymentStatus, expiresAt])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  variantId     String
  // Snapshot at time of sale
  productNameHi String
  variantLabel  String
  sku           String
  hsnCode       String
  quantity      Int
  /// Unit price inclusive of GST.
  unitPrice     Decimal @db.Decimal(10, 2)
  mrp           Decimal @db.Decimal(10, 2)
  gstRate       Decimal @db.Decimal(5, 2)
  taxableValue  Decimal @db.Decimal(12, 2)
  cgst          Decimal @default(0) @db.Decimal(12, 2)
  sgst          Decimal @default(0) @db.Decimal(12, 2)
  igst          Decimal @default(0) @db.Decimal(12, 2)
  lineTotal     Decimal @db.Decimal(12, 2)

  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  allocations OrderItemBatch[]

  @@index([orderId])
}

/// Which inventory batches an order item was fulfilled from (FEFO).
model OrderItemBatch {
  orderItemId String
  batchId     String
  quantity    Int

  orderItem OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  batch     InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@id([orderItemId, batchId])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  adminUserId String?
  createdAt   DateTime     @default(now())

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

// ───────────────────────────── Payments ─────────────────────────────

model Payment {
  id               String        @id @default(cuid())
  orderId          String
  provider         String        @default("razorpay")
  gatewayOrderId   String?       @unique
  gatewayPaymentId String?       @unique
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("INR")
  status           PaymentStatus @default(CREATED)
  /// Method reported by the gateway: upi, card, netbanking, wallet…
  method           String?
  rawPayload       Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([orderId])
}

model Refund {
  id              String       @id @default(cuid())
  orderId         String
  paymentId       String?
  amount          Decimal      @db.Decimal(12, 2)
  reason          String?
  status          RefundStatus @default(PENDING)
  gatewayRefundId String?      @unique
  restocked       Boolean      @default(false)
  adminUserId     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment   Payment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

/// Stored webhook events so each one is processed exactly once.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String    @unique
  type        String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

/// Outgoing customer / owner messages (order updates). Kept as an outbox and audit trail.
model Notification {
  id        String              @id @default(cuid())
  orderId   String?
  channel   NotificationChannel
  /// "CUSTOMER" or "OWNER"
  audience  String
  /// 10-digit mobile number
  recipient String
  /// Event name, e.g. "ORDER_PLACED", "ORDER_SHIPPED"
  template  String
  body      String
  status    NotificationStatus  @default(QUEUED)
  provider  String?
  error     String?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, createdAt])
}

// ───────────────────────────── Leads, Promotions, Delivery ─────────────────────────────

model Enquiry {
  id         String        @id @default(cuid())
  name       String
  mobile     String
  message    String
  productId  String?
  customerId String?
  status     EnquiryStatus @default(NEW)
  source     EnquirySource @default(FORM)
  adminNote  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  type          CouponType
  value         Decimal    @db.Decimal(10, 2)
  minOrderValue Decimal?   @db.Decimal(10, 2)
  maxDiscount   Decimal?   @db.Decimal(10, 2)
  startsAt      DateTime?
  endsAt        DateTime?
  usageLimit    Int?
  usedCount     Int        @default(0)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  orders Order[]
}

model ServiceablePincode {
  pincode        String   @id
  city           String
  district       String?
  state          String   @default("Madhya Pradesh")
  /// Overrides the default flat shipping charge when set.
  deliveryCharge Decimal? @db.Decimal(10, 2)
  codAllowed     Boolean  @default(true)
  etaDays        Int      @default(2)
  isActive       Boolean  @default(true)
}

// ───────────────────────────── System ─────────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String?
  action      String
  entityType  String
  entityId    String?
  meta        Json?
  ip          String?
  createdAt   DateTime @default(now())

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}
